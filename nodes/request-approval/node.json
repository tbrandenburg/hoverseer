{
  "id": "request-approval",
  "label": "Request approval",
  "activity": "requestApproval",
  "taskQueue": "hoverseer-activities",
  "inputSchema": {
    "type": "object",
    "required": [
      "title"
    ],
    "properties": {
      "title": {
        "type": "string",
        "pattern": "\\S",
        "maxLength": 160,
        "default": "Review request"
      },
      "context": {
        "type": "string",
        "description": "Markdown shown to the reviewer."
      },
      "payload": {
        "type": "object",
        "description": "JSON details shown with the review request."
      }
    }
  },
  "multiline": [
    "context"
  ]
}
