#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

usage() {
  cat <<'USAGE'
Usage
  ./poc init
  ./poc docker up|configure|reload|stop
  ./poc kubernetes build|up|configure|reload|forward
  ./poc docker|kubernetes start AMOUNT_CENTS [ORDER_ID]
USAGE
}

if [[ ${1:-} == init ]]; then
  if [[ -e .env ]]; then
    printf '%s\n' '.env already exists.'
    exit 0
  fi
  umask 077
  auth_secret=$(openssl rand -hex 32)
  db_password=$(openssl rand -hex 24)
  {
    printf 'BETTER_AUTH_SECRET=%s\n' "$auth_secret"
    printf 'POSTGRES_PASSWORD=%s\n' "$db_password"
    printf 'HITLY_PROJECT_ID=\nHITLY_API_KEY=\n'
  } > .env
  printf '%s\n' 'Created .env. Fill in the HITLy project ID and API key after creating a project.'
  exit 0
fi

backend=${1:-}
action=${2:-}
namespace=hoverseer
case "$backend" in
  docker|kubernetes) ;;
  *) usage; exit 2 ;;
esac

kube() {
  kubectl -n "$namespace" "$@"
}

configure_kubernetes() {
  kube create secret generic poc-config --from-env-file=.env --dry-run=client -o yaml |
    kube apply --server-side --field-manager=hoverseer -f -
}

require_env() {
  if [[ ! -f .env ]]; then
    printf '%s\n' 'Run ./poc init first.' >&2
    exit 2
  fi
}

start_workflow() {
  local amount=${1:-}
  local order=${2:-demo-order}
  if [[ ! $amount =~ ^[1-9][0-9]{0,8}$ ]] || (( amount > 100000000 )) ||
      [[ ! $order =~ ^[a-zA-Z0-9._-]{1,80}$ ]]; then
    printf '%s\n' 'Use 1–100000000 cents and an order ID containing only letters, numbers, periods, underscores or dashes.' >&2
    exit 2
  fi
  local workflow_id="refund-$(openssl rand -hex 12)"
  local input
  printf -v input '{"orderId":"%s","amountCents":%s}' "$order" "$amount"
  local -a args=(workflow start --type refundReview --task-queue refund-review
    --workflow-id "$workflow_id" --input "$input")
  if [[ $backend == docker ]]; then
    require_env
    docker compose exec -T temporal temporal "${args[@]}"
  else
    kube exec deployment/temporal -- temporal "${args[@]}"
  fi
  printf 'Temporal Web: http://localhost:8233/namespaces/default/workflows/%s\n' "$workflow_id"
}

case "$backend:$action" in
  docker:up)
    require_env
    docker compose up -d --build
    ;;
  docker:configure)
    require_env
    docker compose up -d --no-deps approval-gateway
    ;;
  docker:reload)
    require_env
    docker compose restart zigflow
    ;;
  docker:stop)
    require_env
    docker compose stop
    ;;
  kubernetes:build)
    docker build -f images/studio.Dockerfile -t hoverseer-studio:local .
    docker build -f images/hitly.Dockerfile -t hoverseer-hitly:local .
    ;;
  kubernetes:up)
    require_env
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -
    configure_kubernetes
    kubectl apply -k .
    ;;
  kubernetes:configure)
    require_env
    configure_kubernetes
    kube rollout restart deployment/approval-gateway
    kube rollout status deployment/approval-gateway --timeout=120s
    ;;
  kubernetes:reload)
    kube rollout restart deployment/workflow
    kube rollout status deployment/workflow --timeout=120s
    ;;
  kubernetes:forward)
    pids=()
    trap 'kill "${pids[@]}" 2>/dev/null || true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    kube port-forward service/studio 3000:3000 & pids+=("$!")
    kube port-forward service/hitly 3001:3001 & pids+=("$!")
    kube port-forward service/temporal 8233:8233 & pids+=("$!")
    wait -n "${pids[@]}"
    ;;
  docker:start|kubernetes:start)
    start_workflow "${3:-}" "${4:-}"
    ;;
  *) usage; exit 2 ;;
esac
