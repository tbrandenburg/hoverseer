{
  "id": "run-shell",
  "activity": "runShell",
  "label": "Run shell",
  "inputSchema": {
    "type": "object",
    "required": ["script"],
    "properties": {
      "script": {"type": "string", "minLength": 1},
      "shell": {"enum": ["sh", "bash"], "default": "sh"},
      "environment": {"type": "object", "additionalProperties": {"type": "string"}},
      "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 60}
    }
  }
}
