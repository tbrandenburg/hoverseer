#!/usr/bin/env bash
set -euo pipefail
invocation_dir=$PWD
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

usage() {
  cat <<'USAGE'
Usage
  ./hoverseer init
  ./hoverseer docker up|configure|reload|stop
  ./hoverseer kubernetes build|up|configure|reload|forward
  ./hoverseer docker|kubernetes start WORKFLOW_TYPE JSON [--task-queue QUEUE]
  ./hoverseer docker|kubernetes import PROJECT WORKFLOW_FILE
  ./hoverseer docker|kubernetes start AMOUNT_CENTS [ORDER_ID]
USAGE
}

if [[ ${1:-} == init ]]; then
  if [[ -e .env ]]; then
    if ! grep -q '^HOVERSEER_API_TOKEN=' .env; then
      api_token=$(openssl rand -hex 32)
      printf '\nHOVERSEER_API_TOKEN=%s\n' "$api_token" >> .env
      printf '%s\n' 'Added the workflow API token to .env.'
    else
      printf '%s\n' '.env already exists.'
    fi
    exit 0
  fi
  umask 077
  auth_secret=$(openssl rand -hex 32)
  db_password=$(openssl rand -hex 24)
  api_token=$(openssl rand -hex 32)
  {
    printf 'BETTER_AUTH_SECRET=%s\n' "$auth_secret"
    printf 'POSTGRES_PASSWORD=%s\n' "$db_password"
    printf 'HITLY_PROJECT_ID=\nHITLY_API_KEY=\n'
    printf 'HOVERSEER_API_TOKEN=%s\n' "$api_token"
  } > .env
  printf '%s\n' 'Created .env. Fill in the HITLy project ID and API key after creating a project.'
  exit 0
fi

backend=${1:-}
action=${2:-}
namespace=hoverseer
case "$backend" in
  docker|kubernetes) ;;
  *) usage; exit 2 ;;
esac

kube() {
  kubectl -n "$namespace" "$@"
}

configure_kubernetes() {
  kube create secret generic hoverseer-config --from-env-file=.env --dry-run=client -o yaml |
    kube apply --server-side --field-manager=hoverseer -f -
}

require_env() {
  if [[ ! -f .env ]]; then
    printf '%s\n' 'Run ./hoverseer init first.' >&2
    exit 2
  fi
}

exec_service() {
  local service=$1
  shift
  if [[ $backend == docker ]]; then
    require_env
    docker compose exec -T "$service" "$@"
  elif [[ $service == studio ]]; then
    kube exec -i deployment/workflow -c studio -- "$@"
  else
    kube exec -i deployment/temporal -- "$@"
  fi
}

start_workflow() {
  local workflow_type=$1
  local input=$2
  local queue=$3
  local id_prefix=${4:-run}
  local workflow_id="$id_prefix-$(openssl rand -hex 12)"
  exec_service temporal temporal workflow start --type "$workflow_type" \
    --task-queue "$queue" --workflow-id "$workflow_id" --input="$input"
  printf 'Temporal Web: http://localhost:8233/namespaces/default/workflows/%s\n' "$workflow_id"
}

start_refund() {
  local amount=$1
  local order=${2:-example-order}
  if [[ ! $amount =~ ^[1-9][0-9]{0,8}$ ]] || (( amount > 100000000 )) ||
      [[ ! $order =~ ^[a-zA-Z0-9._-]{1,80}$ ]]; then
    printf '%s\n' 'Use 1–100000000 cents and an order ID containing only letters, numbers, periods, underscores or dashes.' >&2
    exit 2
  fi
  local input
  printf -v input '{"orderId":"%s","amountCents":%s}' "$order" "$amount"
  start_workflow refundReview "$input" refund-review refund
}

import_workflow() {
  local project=$1
  local file=$2
  if [[ $file != /* ]]; then
    file=$invocation_dir/$file
  fi
  if [[ ! $project =~ ^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,61}[a-zA-Z0-9])?$ || ! -f $file ]]; then
    printf '%s\n' 'Provide a Studio project name and an existing workflow YAML file.' >&2
    exit 2
  fi

  exec_service studio sh -eu -c '
    root=${ZIGFLOW_STORAGE_DIR:-/workflows}
    project_dir="$root/$1"
    stage=$(mktemp "$root/.import.XXXXXX.yaml")
    trap "rm -f -- \"\$stage\"" EXIT
    cat > "$stage"
    zigflow validate --disable-telemetry "$stage"
    chmod 644 "$stage"
    mkdir -p "$project_dir"
    if ! ln -T "$stage" "$project_dir/workflow.yaml"; then
      printf "%s\n" "Could not import. Edit an existing project in Studio." >&2
      exit 1
    fi
  ' sh "$project" < "$file"
  printf 'Imported %s. Run ./hoverseer %s reload to register it.\n' "$project" "$backend"
}

case "$backend:$action" in
  docker:up)
    require_env
    docker compose up -d --build
    ;;
  docker:configure)
    require_env
    docker compose up -d --no-deps cruncher approval-gateway
    ;;
  docker:reload)
    require_env
    docker compose restart zigflow api
    ;;
  docker:stop)
    require_env
    docker compose stop
    ;;
  kubernetes:build)
    docker build -f images/studio.Dockerfile -t hoverseer-studio:local .
    docker build -f images/hitly.Dockerfile -t hoverseer-hitly:local .
    docker build -f images/api.Dockerfile -t hoverseer-api:local .
    docker build -f images/cruncher.Dockerfile -t hoverseer-cruncher:local .
    ;;
  kubernetes:up)
    require_env
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -
    configure_kubernetes
    kubectl apply -k .
    ;;
  kubernetes:configure)
    require_env
    configure_kubernetes
    kube rollout restart deployment/cruncher deployment/approval-gateway
    kube rollout status deployment/cruncher --timeout=120s
    kube rollout status deployment/approval-gateway --timeout=120s
    ;;
  kubernetes:reload)
    kube rollout restart deployment/workflow
    kube rollout status deployment/workflow --timeout=120s
    ;;
  kubernetes:forward)
    pids=()
    trap 'kill "${pids[@]}" 2>/dev/null || true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    kube port-forward service/studio 3000:3000 & pids+=("$!")
    kube port-forward service/hotl 3001:3001 & pids+=("$!")
    kube port-forward service/temporal 8233:8233 & pids+=("$!")
    kube port-forward service/api 8081:8081 & pids+=("$!")
    wait -n "${pids[@]}"
    ;;
  docker:start|kubernetes:start)
    if [[ ${3:-} =~ ^[0-9]+$ && $# -le 4 ]]; then
      start_refund "$3" "${4:-}"
    elif [[ $# -eq 4 && -n $3 && -n $4 ]]; then
      start_workflow "$3" "$4" "$3"
    elif [[ $# -eq 6 && -n $3 && -n $4 && $5 == --task-queue && -n $6 ]]; then
      start_workflow "$3" "$4" "$6"
    else
      usage
      exit 2
    fi
    ;;
  docker:import|kubernetes:import)
    if [[ $# -ne 4 ]]; then
      usage
      exit 2
    fi
    import_workflow "$3" "$4"
    ;;
  *) usage; exit 2 ;;
esac
